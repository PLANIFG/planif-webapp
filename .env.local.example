# Copiez ce fichier en ".env.local" pour le développement local,
# et entrez ces mêmes valeurs dans les paramètres de votre site sur Netlify
# (Site settings → Environment variables) pour le déploiement.

# Depuis console.anthropic.com → API Keys → Create Key
# NE JAMAIS mettre le préfixe NEXT_PUBLIC_ devant celle-ci : elle doit
# rester strictement côté serveur.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Depuis votre projet Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Depuis Supabase → Project Settings → API → service_role (SECRÈTE,
# ne jamais préfixer par NEXT_PUBLIC_ — donne un accès complet à la base)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Depuis dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Depuis dashboard.stripe.com → Developers → Webhooks → (après création)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Prix ajustables en tout temps, sans toucher au code (en cents CAD)
STRIPE_MONTHLY_PRICE_CENTS=999
STRIPE_ANNUAL_PRICE_CENTS=8900

# L'adresse complète de votre site en ligne
SITE_URL=https://beamish-froyo-c13982.netlify.app
