# Copiez ce fichier en ".env.local" pour le développement local,
# et entrez ces mêmes valeurs dans les paramètres de votre site sur Netlify
# (Site settings → Environment variables) pour le déploiement.

# Depuis console.anthropic.com → API Keys → Create Key
# NE JAMAIS mettre le préfixe NEXT_PUBLIC_ devant celle-ci : elle doit
# rester strictement côté serveur.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Depuis votre projet Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
